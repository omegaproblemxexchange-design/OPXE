# Server-only PostgreSQL connection string. Keep the real value in ignored .env.local.
DATABASE_URL=

# Clerk authentication (only the publishable key may be sent to the browser).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
OPXE_HEAD_EMAIL=

# Cloudinary image storage (server-only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL used for metadata and the Android wrapper.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CAPACITOR_SERVER_URL=
